# Caddy atrás da Cloudflare (SSL Full strict com certificado de origem).
(common) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode zstd gzip
	php_fastcgi unix//run/php/php8.4-fpm.sock
	file_server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	@static path *.css *.js *.woff2 *.png *.jpg *.webp *.svg *.ico
	header @static Cache-Control "public, max-age=31536000, immutable"
}

www.estrela6.com.br {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	redir https://estrela6.com.br{uri} permanent
}

estrela6.com.br {
	root * /var/www/estrela6/production/current/public
	import common
}

staging.estrela6.com.br {
	root * /var/www/estrela6/staging/current/public
	basic_auth {
		equipe __STAGING_HASH__
	}
	header X-Robots-Tag "noindex, nofollow"
	import common
}
